; ==============================================================================
; extensions.conf - Dialplan do Asterisk para o Rock Assistant
; ==============================================================================

[general]
static = yes
writeprotect = no

; Contexto para chamadas recebidas (Inbound)
; Roteia a chamada diretamente para a aplicação Stasis 'rock_agent'
[rock-inbound]
exten => _X.,1,NoOp(Rock Inbound: Origem=${CALLERID(num)}, Destino=${EXTEN})
 same => n,Answer()
 same => n,Stasis(rock_agent,inbound,${CALLERID(num)},${EXTEN})
 same => n,Hangup()

exten => s,1,NoOp(Rock Inbound: Origem=${CALLERID(num)}, Destino=s)
 same => n,Answer()
 same => n,Stasis(rock_agent,inbound,${CALLERID(num)},s)
 same => n,Hangup()

; Contexto para chamadas originadas (Outbound)
[rock-outbound]
exten => _X.,1,NoOp(Rock Outbound: Ligando para ${EXTEN})
 same => n,Dial(PJSIP/${EXTEN}@pstn-trunk,60)
 same => n,Hangup()
